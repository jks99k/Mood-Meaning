# ==============================================================================
# .gitignore
# GitHub 저장소에 절대 올리지 말아야 할 민감 정보 및 불필요한 파일 목록
# ==============================================================================

# 1. API 비밀 키 및 환경 변수 (보안 최우선 - 절대 커밋 금지)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# 2. 대용량 외부 패키지 라이브러리 폴더 (package.json으로 재설치 가능)
node_modules/
.pnp
.pnp.js

# 3. 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Vercel 배포 캐시 및 설정 폴더
.vercel

# 5. 운영체제 생성 임시 파일
.DS_Store
Thumbs.db
