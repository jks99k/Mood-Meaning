# ==============================================================================
# 환경 변수 템플릿 (.env.example)
# 이 파일은 저장소에 공개되므로 실제 비밀 키를 절대 입력하지 마세요.
# ==============================================================================

# 1. OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 2. 감성 분석 모델명 (예: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# 3. Supabase 프로젝트 URL (Supabase 대시보드 -> Project Settings -> API)
SUPABASE_URL=

# 4. Supabase Service Role Key (서버 전용 비밀 키 - 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

